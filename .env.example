# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PAYMENT_ENV=PREVIEW

# Database / authentication
DATABASE_URL=postgresql://bunnyera:replace_me@127.0.0.1:5432/bunnyera_pay?schema=public
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=24h
PAYMENT_CONFIG_ENCRYPTION_KEY=replace_with_32_random_bytes_encoded_as_base64

# Optional Redis / Docker
REDIS_URL=redis://:replace_me@127.0.0.1:6379
DB_USER=bunnyera
DB_PASSWORD=replace_me
DB_NAME=bunnyera_pay
REDIS_PASSWORD=replace_me

# Alipay (leave empty until official credentials are provisioned)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PLATFORM_PUBLIC_KEY=
ALIPAY_PLATFORM_CERTIFICATE=
ALIPAY_APP_CERT_SN=
ALIPAY_ROOT_CERT_SN=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=
ALIPAY_NOTIFY_URL=

# WeChat Pay API v3 (leave empty until official credentials are provisioned)
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_KEY_PATH=
WECHAT_SERIAL_NO=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_CERT_PATH=
WECHAT_PLATFORM_SERIAL_NO=
